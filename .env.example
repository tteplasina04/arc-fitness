# База PostgreSQL. Для локального docker-compose можно оставить значение ниже.
DATABASE_URL=postgresql://arc_user:arc_password@localhost:5432/arc_fitness

# В режиме разработки код подтверждения при отсутствии SMTP записывается только в лог сервера.
# В интерфейсе код подтверждения не показывается.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Email через SMTP Яндекса (для отправки кодов подтверждения).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Уведомления Telegram (необязательно для запуска, но нужны для реальных уведомлений).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Создать администратора при первом запуске. Не используйте пароль из примера.
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=INFO
